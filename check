#!/bin/sh
# Проектные проверки: зовутся pre-commit'ом и вручную (./check).
set -e
cd "$(dirname "$0")" || exit 1
# PreToolUse-guard агента живёт вне репо (~/.claude/hooks) и здесь не проверяется.

# Тесты тулинга: зелёные — одна строка итога, красные — весь вывод и выход.
# (`… | tail -1` глотал код возврата: упавший тест проходил молча.)
# GIT_INDEX_FILE и др. от pre-commit тестам не отдаём: свои временные репозитории они бы ломали.
quiet_test() {
  out=$(env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE python3 "$1" 2>&1) || { printf '%s\n' "$out"; exit 1; }
  printf '%s\n' "$out" | tail -1
}

# --- секреты: токены ботов в отслеживаемых файлах (SEC-001) ---
if [ -f tools/secret_scan.py ]; then
  quiet_test tools/test_secret_scan.py
  python3 tools/secret_scan.py
fi

# --- документация: шапки спек/планов/ADR, связи, автоиндексы ---
if [ -f tools/docs_gate.py ]; then
  python3 tools/docs_gate.py
fi

# --- справочник HTTP API (docs/api-routes.md) не отстал от маршрутов в коде (DX-005) ---
if [ -f tools/api_routes.py ]; then
  quiet_test tools/test_api_routes.py
  python3 tools/api_routes.py --check
fi

# --- бэклог (backlog/ главного checkout, вне git): шапки задач, связи, индекс и журнал ---
if [ -f tools/tasks_gate.py ]; then
  python3 tools/test_tasks_gate.py
  python3 tools/tasks_gate.py
fi

# --- сдвиг staging только fast-forward с compare-and-swap (грабли 3) ---
if [ -f tools/advance-staging.sh ]; then
  quiet_test tools/test_advance_staging.py
fi

# --- версия: одна во всех pyproject, __version__ и uv.lock; release-скрипт (DX-009) ---
if [ -f tools/release.py ]; then
  quiet_test tools/test_release.py
fi

# --- код: `make check` в каждом сервисе app/<svc>/ с Makefile ---
# В pre-commit — только сервисы с файлами в индексе; вручную и в ./finish — все.
# Новый сервис: каталог app/<svc>/ с Makefile и целью check.
if [ -d app ]; then
  if [ -n "$GIT_INDEX_FILE" ]; then
    svcs=$(git diff --cached --name-only --diff-filter=ACMR -- app/ | \
      sed -n 's#^\(app/[^/]*\)/.*#\1#p' | sort -u)
  else
    svcs=$(ls -d app/*/ 2>/dev/null | sed 's#/$##')
  fi
  for d in $svcs; do
    [ -f "$d/Makefile" ] || continue
    echo "→ make check: $d"
    make -C "$d" check
  done
fi

# --- добавь сюда проверки своего проекта (линтер, тесты) ---
